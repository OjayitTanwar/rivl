{
  "name": "rivl",
  "version": "1.0.0",
  "description": "RIVL \u2014 a native iOS and Android training app",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start --dev-client",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "doctor": "npx expo-doctor",
    "postinstall": "node scripts/native-dependency-fixes.mjs",
    "ios:prepare": "expo prebuild --platform ios --no-install",
    "ios:bundle": "expo export --platform ios --output-dir build/ios-bundle",
    "ios:check": "node scripts/check-ios.mjs",
    "ios:simulator": "bash scripts/run-ios.sh",
    "e2e:shared": "playwright test",
    "e2e:ios": "maestro test .maestro",
    "format": "prettier --write app src tests scripts",
    "security:check": "node scripts/security-preflight.mjs",
    "security:release": "node scripts/security-preflight.mjs --production",
    "eas-build-post-install": "node scripts/security-preflight.mjs",
    "backend:check": "node scripts/backend-readiness.mjs",
    "install:iphone": "bash scripts/install-iphone.sh"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@bacons/apple-targets": "^5.0.0",
    "@expo/metro-runtime": "~55.0.12",
    "@kingstinct/react-native-healthkit": "^16.0.0",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/netinfo": "11.5.2",
    "@sentry/react-native": "~7.11.0",
    "@supabase/supabase-js": "^2.117.3",
    "@xmldom/xmldom": "^0.9.12",
    "base64-js": "^1.5.1",
    "expo": "~55.0.0",
    "expo-asset": "~55.0.20",
    "expo-build-properties": "~55.0.18",
    "expo-camera": "~55.0.23",
    "expo-constants": "~55.0.17",
    "expo-crypto": "~55.0.19",
    "expo-dev-client": "~55.0.40",
    "expo-document-picker": "~55.0.17",
    "expo-file-system": "~55.0.26",
    "expo-glass-effect": "~55.0.11",
    "expo-haptics": "~55.0.18",
    "expo-image-picker": "~55.0.24",
    "expo-linking": "~55.0.17",
    "expo-location": "~55.1.14",
    "expo-notifications": "~55.0.27",
    "expo-router": "~55.0.18",
    "expo-secure-store": "~55.0.18",
    "expo-sharing": "~55.0.24",
    "expo-speech": "~55.0.18",
    "expo-speech-recognition": "3.1.3",
    "expo-sqlite": "~55.0.20",
    "expo-status-bar": "~55.0.6",
    "expo-system-ui": "~55.0.22",
    "expo-task-manager": "~55.0.20",
    "expo-web-browser": "~55.0.20",
    "lucide-react-native": "^1.52.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-native": "0.83.10",
    "react-native-ble-plx": "^3.5.1",
    "react-native-health-connect": "^4.1.3",
    "react-native-safe-area-context": "~5.6.2",
    "react-native-screens": "~4.23.0",
    "react-native-svg": "15.15.3",
    "react-native-view-shot": "4.0.3",
    "react-native-web": "^0.21.0",
    "react-native-webview": "13.16.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@resvg/resvg-js": "^2.6.2",
    "@types/react": "~19.2.10",
    "esbuild": "^0.28.2",
    "prettier": "^3.9.9",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.0.3"
  },
  "private": true,
  "overrides": {
    "@xmldom/xmldom": "$@xmldom/xmldom",
    "uuid": "11.1.1",
    "decode-uri-component": "0.5.0",
    "@istanbuljs/load-nyc-config": {
      "js-yaml": "4.3.2"
    }
  }
}
