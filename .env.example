EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
EXPO_PUBLIC_MAP_STYLE_URL=
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=
EXPO_PUBLIC_GOOGLE_SIGNIN_ENABLED=false
EXPO_PUBLIC_APPLE_SIGNIN_ENABLED=false
# Authorized referrer for the embedded Google Maps JavaScript renderer.
EXPO_PUBLIC_GOOGLE_MAPS_BASE_URL=https://rivl.app/
EXPO_PUBLIC_ENABLE_DEMO=false
EXPO_PUBLIC_ENABLE_ROUTE_INTENT=false
EXPO_PUBLIC_SENTRY_DSN=

RIVL_PINNED_HOST=
RIVL_TLS_SPKI_PINS=

# HTTPS OSRM deployments using foot and bicycle profiles.
# The defaults are public low-volume development services.
EXPO_PUBLIC_ROUTING_FOOT_URL=https://routing.openstreetmap.de/routed-foot
EXPO_PUBLIC_ROUTING_BIKE_URL=https://routing.openstreetmap.de/routed-bike

# Optional Mapbox fallback; use a public, restricted token only.
EXPO_PUBLIC_MAPBOX_ACCESS_TOKEN=
